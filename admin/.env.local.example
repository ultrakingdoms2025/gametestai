# ── Database (Vercel Postgres / Neon) ─────────────────────────────────────────
# Create a Postgres database at vercel.com/dashboard → Storage → Create Database
# OR use any Neon-compatible Postgres URL.
POSTGRES_URL="postgres://user:pass@host/db?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://user:pass@host/db?sslmode=require"

# ── Cryptographic secrets ─────────────────────────────────────────────────────
# GENERATE THESE THREE SEPARATELY FOR EVERY ENVIRONMENT. A development machine
# that shares production's SESSION_SECRET can forge production admin sessions;
# one that shares ENCRYPTION_KEY can decrypt production TOTP secrets and player
# emails; one that shares HMAC_SECRET can forge audit-chain entries. The app
# refuses to serve if any of the three is missing or under 32 characters
# (lib/env.ts), but it cannot tell whether you reused a value — only you can.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="<32-byte base64 key>"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET="<64-char hex string>"

# Minimum 32 random characters
SESSION_SECRET="<at-least-32-random-chars>"

# ── Service-to-service auth (game site → admin) ──────────────────────────────
# THERE IS NO KEY HERE ON PURPOSE.
#
# A `SERVICE_API_KEY` used to be listed here. Nothing read it — no route exists
# under /api/service — and the value was byte-identical in admin/.env.local,
# admin/.env.production.local and site/.env.local, so it was one unused
# credential shared by a laptop and production. That is a liability with no
# upside, so it is gone.
#
# When a service route is genuinely built, mint its secret THEN, generate a
# DIFFERENT value per environment, and verify it inside proxy.ts with a
# constant-time comparison before any handler runs. Do not reinstate the
# unauthenticated /api/service skip proxy.ts used to have.

# ── Admin URL (for CORS on service API) ──────────────────────────────────────
ADMIN_URL="https://your-admin.vercel.app"