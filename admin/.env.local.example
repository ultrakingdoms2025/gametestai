# ── Database (Vercel Postgres / Neon) ─────────────────────────────────────────
# Create a Postgres database at vercel.com/dashboard → Storage → Create Database
# OR use any Neon-compatible Postgres URL.
POSTGRES_URL="postgres://user:pass@host/db?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://user:pass@host/db?sslmode=require"

# ── Cryptographic secrets ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="<32-byte base64 key>"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET="<64-char hex string>"

# Minimum 32 random characters
SESSION_SECRET="<at-least-32-random-chars>"

# ── Service-to-service auth (game site → admin) ──────────────────────────────
# NOT YET IN USE. No route exists under /api/service, and proxy.ts no longer
# waves that prefix through unauthenticated — it used to, which meant the first
# file added there would have been public the moment it landed. When a service
# route is genuinely built, verify this key inside proxy.ts with a constant-time
# comparison before any handler runs. Do not reinstate a skip.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_API_KEY="<64-char hex string>"

# ── Admin URL (for CORS on service API) ──────────────────────────────────────
ADMIN_URL="https://your-admin.vercel.app"