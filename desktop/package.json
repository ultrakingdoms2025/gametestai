{
  "name": "aether-nexus-desktop",
  "version": "1.0.0",
  "author": "Aether Nexus",
  "description": "Aether Nexus desktop launcher for Windows, Steam, and Microsoft Store packaging.",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:store": "electron-builder --win appx",
    "dist:steam": "electron-builder --win zip"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "games.aethernexus.desktop",
    "productName": "Aether Nexus",
    "icon": "icon.ico",
    "directories": {
      "output": "release"
    },
    "artifactName": "Aether-Nexus-${version}-steam-${arch}.${ext}",
    "afterPack": "./afterPack.cjs",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Aether-Nexus-${version}-installer-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Aether-Nexus-${version}-portable-${arch}.${ext}"
    },
    "appx": {
      "identityName": "AETHERNEXUS.AETHERNEXUS",
      "applicationId": "AETHERNEXUS",
      "publisher": "CN=913BC31F-41D3-482F-9D90-7462984A0343",
      "publisherDisplayName": "AETHER NEXUS",
      "artifactName": "Aether-Nexus-${version}-store-${arch}.${ext}"
    }
  }
}
