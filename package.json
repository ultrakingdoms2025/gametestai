{
  "name": "aether-nexus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AETHER NEXUS - a first-person metaverse shooter spanning six worlds",
  "scripts": {
    "dev": "concurrently -k -n VITE,CHAT -c cyan,magenta \"vite\" \"node server/chat-server.js\"",
    "vite": "vite",
    "chat": "node server/chat-server.js",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node --test scripts/tests/*.test.mjs",
    "test:watch": "node --test --watch scripts/tests/*.test.mjs",
    "test:layout": "node scripts/hud-viewport-probe.mjs",
    "quests:offline": "node scripts/gen-offline-quests.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.27.7",
    "vite": "8.1.5"
  }
}
