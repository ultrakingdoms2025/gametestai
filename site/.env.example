# ============================================================================
# AETHER NEXUS — site environment
#
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables.
#
# Everything here is optional except APP_SECRET in production. With no Stripe
# keys the site runs in simulated mode: the full checkout flow works, the real
# totals are shown, and no card is taken.
# ============================================================================

# --- Required, everywhere -----------------------------------------------------
# Signs sessions, launch cookies, password-reset tokens, 2FA recovery codes and
# simulated-order signatures. There is NO fallback any more: every one of those
# used to degrade to a constant published in this repository, which means anyone
# could mint a session for any account. Under 32 characters is refused, matching
# admin/lib/session.ts. See lib/appSecret.ts.
#
# NEXTAUTH_SECRET is preferred; APP_SECRET is accepted as the older name. Set
# ONE of them (setting both is fine, NEXTAUTH_SECRET wins). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# --- Simulated purchases (development only) -----------------------------------
# Lets /api/checkout mint, and /api/confirm settle, a purchase that nobody paid
# for. This grants REAL paid access, REAL credits and a REAL hosting
# entitlement, so it must never be on where money is involved.
#
# Fails closed: unset (or anything other than exactly "1") means refused. It is
# ALSO refused outright when VERCEL_ENV=production, whatever this says, and when
# STRIPE_SECRET_KEY is present.
#
# Leaving this blank on a deployment with no Stripe key means the store cannot
# complete a purchase at all — which is the honest state for a deployment that
# cannot take payments. That is the intended production behaviour; set the
# Stripe keys to sell anything.
ALLOW_SIMULATED_PURCHASE=

# --- Stripe (leave blank to keep checkout simulated) ------------------------
# Setting STRIPE_SECRET_KEY switches checkout to live payments AND disables the
# simulated-confirm bypass in the same move.
STRIPE_SECRET_KEY=
# Only needed once the webhook below is wired up.
STRIPE_WEBHOOK_SECRET=

# --- Fees -------------------------------------------------------------------
# Stripe's standard domestic card rate, as basis points plus a fixed amount.
# These are what gets added on top of the listed prices so the listed price is
# what reaches you. Change them if your account's rate differs.
STRIPE_FEE_BPS=290
STRIPE_FEE_FIXED_CENTS=30

# --- URLs -------------------------------------------------------------------
# Absolute origin used for checkout redirects. Leave blank on Vercel — it is
# derived from VERCEL_URL, so preview deployments redirect back to themselves.
NEXT_PUBLIC_SITE_URL=https://www.aethernexus.games

# Where the game lives. Leave blank to serve the bundle from this deployment
# (run `npm run bundle-game` first), or point at an external host.
NEXT_PUBLIC_GAME_URL=

# --- Admin allowlist --------------------------------------------------------
# Who may use /admin/map (the world-map editor) and the marketplace admin
# routes. Comma-separated, case-insensitive. Fails CLOSED: unset means no
# administrators at all (see lib/adminAllowlist.ts). MARKETPLACE_ADMIN_EMAILS
# is honoured too and merged with this list.
ADMIN_EMAILS=

# --- Auth (NextAuth.js) -----------------------------------------------------
# Required, at least 32 characters, no fallback. Preferred over APP_SECRET above;
# one of the two must be set or every route that signs anything fails closed.
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=

# Google OAuth (optional — email/password works without these)
# Set up at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (password reset) — uses Resend if set, console-log fallback in dev
# Get key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=noreply@aethernexus.games

# ---------------------------------------------------------------------------
# Shared player database
# ---------------------------------------------------------------------------
# The site and the admin app share ONE Postgres database. The admin app owns
# the `players` table and creates it via its own initSchema(); the site adds
# columns to it and reads it. A site deployed against a database where the
# admin app has never run will throw `relation "players" does not exist` on
# every authenticated route.
POSTGRES_URL=

# AES-256-GCM key for the encrypted columns on `players`, base64, decoding to
# exactly 32 bytes. Must match the admin app's key or nothing it wrote can be
# read back.
#
# Without it, registration fails AFTER the player row has been committed: the
# user can sign in, cannot register again, and cannot set a handle. Generate
# with:  openssl rand -base64 32
ENCRYPTION_KEY=

# Signs the site's rows in the shared, chained `audit_log`. Must match the
# admin app's, or `verifyAuditChain()` fails from the first site-written row
# onward and reports it as tampering.
HMAC_SECRET=

# ---------------------------------------------------------------------------
# Tables this app creates for itself
# ---------------------------------------------------------------------------
# No configuration, listed so nobody is surprised by a table appearing. All are
# created lazily with CREATE TABLE / ALTER TABLE ... IF NOT EXISTS on first use,
# in the same shared POSTGRES_URL database:
#
#   rate_limits                 windowed counters for the auth, chat, bug-report
#                               and progress limiters (lib/rateLimit.ts)
#   site_totp_recovery_codes    hashed single-use 2FA recovery codes (lib/db.ts)
#   site_users.totp_pending_secret   an enrolment that has not been confirmed
#   site_users.session_epoch    token generation, bumped to sign every device out

# ---------------------------------------------------------------------------
# Build flags
# ---------------------------------------------------------------------------
# `npm run build` runs scripts/bundle-game.mjs and then `next build`, and the
# bundle step is FATAL: a game that will not build fails the deploy rather than
# shipping whatever bundle is committed in public/game. It used to be the other
# way round, and in that shape it never once succeeded on Vercel — every build
# logged "Cannot find package 'vite'", exited 0, and shipped stale.
#
# BUNDLE_GAME_OPTIONAL=1 (or passing --if-available) softens exactly one case:
# there is no game project at `..` at all, i.e. somebody checked out site/ on
# its own. It is REFUSED whenever VERCEL is set, so do not set it here or in
# Vercel's project settings — it will be ignored and logged. To ship the
# storefront while the game is broken, use `npm run build:site-only`.
# BUNDLE_GAME_OPTIONAL=
